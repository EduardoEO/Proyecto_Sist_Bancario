{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build all",
            "command": "cl.exe",
            "args": [
                "/std:c++17",
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fo.\\build\\obj\\",
                "/Fd.\\build\\output.pdb",
                "/Fe.\\build\\output.exe",
                "src\\*.cpp"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compila todos los archivos .cpp colocando los .obj en build/obj/ y el .exe en build/."
        }
    ],
    "version": "2.0.0"
}